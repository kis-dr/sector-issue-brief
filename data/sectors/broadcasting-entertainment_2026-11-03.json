 대한 증거 수집을 진행하고 있으며, 위법성이 확인되는 사안에 대해서는 민·형사상 법적 대응을 포함한 강력한 조치를 이어갈 방침이다.","url":"https://www.mk.co.kr/article/12193597","published_at":"2026-11-02T16:00:00","sentiment":"neutral","is_new":true}],"disclosures":[{"date":"2026-10-27T16:48:01","title":"유상증자결정(종속회사의주요경영사항)              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027800573","is_new":false},{"date":"2026-10-27T16:43:01","title":"타법인주식및출자증권취득결정              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027800546","is_new":false},{"date":"2026-10-27T16:28:00","title":"타법인주식및출자증권처분결정              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261027800539","is_new":false}],"reports":[],"consensus":{"Q":{"period":"2026년 4분기","latest":143516666666.66998,"is_new":true,"series":[{"date":"2026-10-06","value":143035000000.0},{"date":"2026-10-07","value":143785000000.0},{"date":"2026-10-08","value":144015000000.0},{"date":"2026-10-12","value":143860000000.0},{"date":"2026-10-13","value":144260000000.0},{"date":"2026-10-15","value":143260000000.0},{"date":"2026-10-16","value":143210000000.0},{"date":"2026-10-19","value":143625000000.0},{"date":"2026-10-20","value":142526315789.47},{"date":"2026-10-21","value":142805263157.88998},{"date":"2026-10-22","value":143647368421.05002},{"date":"2026-10-26","value":144350000000.0},{"date":"2026-10-27","value":143950000000.0},{"date":"2026-10-28","value":143700000000.0},{"date":"2026-10-29","value":143131578947.37},{"date":"2026-11-02","value":143516666666.66998}]},"Y":{"period":"2026년","latest":284026315789.47003,"is_new":true,"series":[{"date":"2026-10-06","value":281247619047.62},{"date":"2026-10-07","value":283276190476.18994},{"date":"2026-10-08","value":284090476190.48},{"date":"2026-10-12","value":283804761904.76},{"date":"2026-10-13","value":282985714285.70996},{"date":"2026-10-14","value":283000000000.0},{"date":"2026-10-15","value":282642857142.86},{"date":"2026-10-16","value":282452380952.38},{"date":"2026-10-19","value":2824904