:-1730667000},{"date":"2026-08-06","외인":7650839000,"개인":-9128191000,"기관":2028569000},{"date":"2026-08-05","외인":57307602000,"개인":-56747062000,"기관":1769506000}]},{"code":"161390","name":"한국타이어앤테크놀로지","market":"KSP","price":71500.0,"change_pct":2.0,"market_cap":8857067433500.0,"fwd_pe":5.638788,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1739347045484990799","title":"한국타이어, 쿠프라 전기 해치백 '라발'에 아이온 에보 공급","summary":"전기차 특화 기술 적용…일반 타이어 대비 실내 소음 18%↓ 김성식 기자 = 한국타이어앤테크놀로지(161390)는 독일 폭스바겐그룹 산하 고성능 브랜드 쿠프라의 소형 전기 해치백 '라발' 유럽 판매 모델에 전기차 전용 퍼포먼스 타이어 '아이온 에보'(iON evo)를 신차용 타이어(OE)로 공급한다고 13일 밝혔다.\n\n내연기관 차량에 장착되는 자사 일반 타이어 대비 실내 소음은 18% 줄이면서 마일리지는 15% 높였다.\n\n한국타이어는 2024년부터 3년째 쿠프라와 신차용 타이어(OE) 공급을 이어오고 있다.","url":"https://www.news1.kr/industry/auto-industry/6257883","published_at":"2026-08-13T11:06:00","sentiment":"positive","is_new":true},{"id":"1739407064607887880","title":"“그램피언 포레스트 랠리 석권”…한국타이어, 스코틀랜드서 성능 입증","summary":"한국타이어앤테크놀로지가 영국 스코틀랜드에서 열린 ‘2026 그램피언 포레스트 랠리’에서 랠리용 타이어 ‘다이나프로 R213’의 성능을 입증했다.\n\n한국타이어는 지난 7~8일(현지시각) 열린 2026 그램피언 포레스트 랠리에서 다이나프로 R213을 장착한 드라이버들이 종합 포디엄을 석권했다고 13일 밝혔다.\n\n그램피언 포레스트 랠리는 2027년 ‘월드 랠리 챔피언십(WRC)’ 신규 라운드로 합류 예정인 스코틀랜드 랠리 개최 지역에서 열린 주요 랠리 대회다.","url":"https://www.mk.co.kr/article/12126510","published_at":"2026-08-13T15:05:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-08-11T14:30:38","title":"연결재무제표기준영업(잠정)실적(공정공시)              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260811800304","is_new":false},{"date":"2026-08-10T16:38:02","title":"현금ㆍ현물배당결정              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260810800633","is_new":false},{"date":"2026-08-10T16:38:02","title":"현금ㆍ현물배당을위한주주명부폐쇄(기준일)결정              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260810800629","is_new":false}],"reports":[{"broker":"한화투자증권","title":"원가 상승 영향은 가격과 믹스 개선으로 상쇄","url":"https://ddi-cdn.deepsearch.com/research/company/2026/08/12/1739019201106022412/000-a0876b64789d0b549ea8ea3202269634e5e6ae00.pdf","date":"2026-08-12T13:25:14","summary":"한화투자증권은 한국타이어앤테크놀로지(161390)에 대해 투자의견 Buy를 유지하고 목표주가를 90,000원에서 96,000원으로 상향 조정했다. 2Q26 매출액 5.68조원(+5.8% YoY), 영업이익 5,780억원(+63.4% YoY)으로 시장 기대치를 상회했다. 유럽·중국 고성장, 고인치 타이어 믹스 개선, 열관리부문 턴어라운드가 실적을 견인했다. 3Q 원가 상승이 예상되나 판가 인상과 고부가 제품 확대로 상쇄 가능하며, 배당성향 35% 상향 이행에 따라 주주환원도 강화될 전망이다.","key_points":["2Q26 영업이익 5,780억원(+63.4% YoY)으로 컨센서스 대비 8.1% 상회, 타이어부문 OPM 17.2%로 업계 최고 수준 수익성 시현","3Q 천연/합성고무 가격 급등 및 해상운임 상승으로 매출원가율 전년 대비 3~4%p 상승 예상되나, 지역별 판가 인상(2~4%)과 올웨더/윈터타이어 시즌 수요로 원가 부담 경감 전망","목표주가 96,000원으로 상향(6,000원↑), 2026년 DPS 3,600원·2027년 DPS 5,100원 예상으로 배당수익률 각각 5.5%, 7.8% 전망"],"is_new":false},{"broker":"유진투자증권","title":"2Q26 Review: 유럽 시장 고성장의 힘","url":"https://ddi-cdn.deepsearch.com/research/company/2026/08/12/1739017142453538823/000-16180b7fc072fe05f9e377c809153ce413ff3b52.pdf","date":"2026-08-12T13:17:04","summary":"한국타이어앤테크놀로지의 2Q26 실적은 매출액 5.7조원(+5.8%yoy), 영업이익 5,590억원(+58.0%yoy, OPM 9.8%)으로 시장 컨센서스를 소폭 상회했다. 유럽 시장의 유로화 강세와 중국산 타이어 반덤핑 관세 선제 수요 확대가 실적을 견인했으며, EU의 중국산 타이어 반덤핑 관세에서 한국타이어는 4.3%의 낮은 관세율을 적용받아 유럽 시장 공략에 유리한 위치를 확보했다. 하반기 원자재 가격 상승 우려가 있으나 판가 인상을 통해 극복 가능할 것으로 전망되며, 투자의견 BUY와 목표주가 8만원을 유지한다.","key_points":["2Q26 영업이익 5,590억원(+58.0%yoy, OPM 9.8%)으로 컨센서스 소폭 상회, 유럽(+18%)·중국(+18%) 지역 매출 고성장이 주도","EU 중국산 타이어 반덤핑 관세 예비 판정에서 한국타이어 4.3% 낮은 관세율 적용, 유럽 시장 공격적 확대 계획","하반기 원자재 가격 상승 영향은 8월 정점 후 완화 전망, 유럽·북미·아태 지역 9월까지 2~4% 판가 인상 계획으로 수익성 방어 가능"],"is_new":false}],"consensus":{"Q":{"period":"2026년 3분기","latest":538617647058.82,"is_new":true,"series":[{"date":"2026-07-14","value":543873333333.33},{"date":"2026-07-15","value":543318750000.0},{"date":"2026-07-20","value":538868750000.0},{"date":"2026-08-10","value":540193333333.33},{"date":"2026-08-11","value":530880000000.0},{"date":"2026-08-12","value":538500000000.0},{"date":"2026-08-13","value":538617647058.82}]},"Y":{"period":"2026년","latest":2185741176470.59,"is_new":true,"series":[{"date":"2026-07-14","value":2148586666666.67},{"date":"2026-07-15","value":2147081250