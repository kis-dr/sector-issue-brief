:[{"code":"004170","name":"신세계","market":"KSP","price":423000.0,"change_pct":6.82,"market_cap":3995311563000.0,"fwd_pe":8.731413,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1735623807856676948","title":"신세계 강남 연 매출 4조 시대 성큼… 세계 3대 백화점 노리는 비결은","summary":"외국인 관광객이 몰리며 백화점이 사상 최대 호황을 누리는 가운데 신세계 강남점이 올해 국내 백화점 업계에서 전인미답인 연 매출 4조 원을 넘보고 있다.\n\n신세계 강남점의 저력은 전체 매출의 40%를 떠받치는 국내 최대 명품 라인업이다.\n\n원화 약세에 명품을 찾는 외국인 관광객도 신세계 강남점으로 달려오고 있다.","url":"https://www.hankookilbo.com/news/article/A2026072915300001004?did=NA","published_at":"2026-08-03T04:31:00","sentiment":"positive","is_new":true},{"id":"1735473159383158913","title":"외국인 관광객 덕에 웃는 면세점… 명품 매출 두자릿수 증가","summary":"■'땡큐, 외국인' 면세점 명품 매출 '쑥' 2일 면세업계에 따르면 롯데면세점 명동본점의 올해 상반기 럭셔리 패션 매출은 전년 동기 대비 22% 증가했다.\n\n신세계면세점의 럭셔리 패션 매출도 올해 상반기의 경우 전년 동기 대비 11.3% 증가했다.\n\n면세업계 관계자는 \"상업성 고객을 제외한 럭셔리 패션 매출도 늘어난 것은 개별 외국인 관광객의 명품 구매가 확대됐다는 의미\"라며 \"명품은 글로벌 매장마다 상품 구성이 다른 만큼 기존 가방 외에도 남녀 패션과 화장품, 향수, 크래프트 라인 등 차별화된 상품을 확보하는 것이 중요하다\"고 말했다.","url":"http://www.fnnews.com/news/202608021830387263","published_at":"2026-08-02T18:32:00","sentiment":"positive","is_new":true},{"id":"1735410964205015261","title":"필름 감성에 빠지다… 신세계 센텀시티, 100년 전통 ‘코닥’ 체험형 팝업스토어 오픈","summary":"아날로그 감성을 찾는 MZ세대의 발길을 사로잡기 위해 신세계 센텀시티가 글로벌 사진 브랜드 '코닥'의 체험형 팝업스토어를 연다.\n\n신세계 센텀시티는 오는 9일까지 백화점 지하 2층 하이퍼그라운드에서 글로벌 사진 브랜드 '코닥(KODAK)'의 체험형 팝업스토어를 운영한다.\n\n필름과 일회용 카메라를 5만원 이상 구매한 고객 선착순 200명에게는 코닥 에코백을 증정하며, 모든 구매 고객에게는 코닥 스티커(5000개 한정)를 선착순 지급한다.","url":"https://view.asiae.co.kr/article/2026080214254706231","published_at":"2026-08-02T14:25:47","sentiment":"neutral","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":178722222222.22,"is_new":false,"series":[{"date":"2026-07-01","value":174964705882.35},{"date":"2026-07-02","value":175864705882.35},{"date":"2026-07-03","value":176182352941.18},{"date":"2026-07-07","value":176711764705.87997},{"date":"2026-07-08","value":177476470588.24},{"date":"2026-07-14","value":1790000