0.0,"change_pct":-0.26,"market_cap":2773596547500.0,"fwd_pe":12.004009,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1766797472174313780","title":"아마존, ‘글로벌 1위’ K뷰티에 구애","summary":"2027년 한 해 동안 미국 아마존에서 입점 첫해 매출 100만 달러(약 13억 2000만원)를 달성하는 K뷰티 브랜드 50곳을 육성하는 게 목표다.\n\n아마존은 내년에 신규 K뷰티 셀러 50곳이 미국 스토어 입점 첫해 매출 100만 달러를 달성하도록 돕는 ‘프로젝트 밀리언’을 추진한다.\n\n신 대표에 따르면 미국에서 판매되는 K뷰티 제품의 약 44%가 아마존을 통해 거래된다.","url":"https://www.seoul.co.kr/news/economy/distribution/2026/10/28/20261028030002","published_at":"2026-10-28T05:05:00","sentiment":"positive","is_new":true},{"id":"1766890407939149863","title":"“K-뷰티 지속성장 100% 확신” 윤상현 콜마 부회장의 자신감","summary":"새로운 브랜드의 탄생부터 화장품 제조, 글로벌 유통까지 유기적으로 연결된 산업 생태계가 K-뷰티의 경쟁력이라는 분석이다.\n\n윤 부회장은 이날 강연에서 “K-뷰티 성장의 원동력은 새로운 브랜드의 끊임없는 탄생”이라며 “좋은 아이디어만 있다면 한국콜마와 같은 제조자개발생산(ODM) 기업이 제품을 만들고, 아마존과 같은 글로벌 플랫폼이 전 세계 소비자와 연결해 주는 산업 생태계가 이를 가능하게 한다”라고 설명했다.\n\n한국콜마 관계자는 “앞으로도 아마존과의 파트너십을 바탕으로 새로운 K-뷰티 브랜드들의 탄생과 글로벌 성장을 적극 지원해 나가겠다”라고 말했다.","url":"https://biz.heraldcorp.com/article/10917414","published_at":"2026-10-28T11:08:00","sentiment":"positive","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 4분기","latest":70351500000.0,"is_new":false,"series":[{"date":"2026-09-28","value":66036842105.26},{"date":"2026-09-30","value":66257894736.840004},{"date":"2026-10-01","value":66220000000.0},{"date":"2026-10-06","value":66420000000.0},{"date":"2026-10-07","value":67700000000.0},{"date":"2026-10-08","value":68105263157.89001},{"date":"2026-10-12","value":67973684210.53},{"date":"2026-10-13","value":69056500000.0},{"date":"2026-10-14","value":69556500000.0},{"date":"2026-10-15","value":70081500000.0},{"date":"2026-10-19","value":70351500000.0}]},"Y":{"period":"2026년","latest":350949523809.52,"is_new":false,"series":[{"date":"2026-09-28","value":345822500000.0},{"date":"2026-09-29","value":345532500000.0},{"date":"2026-09-30","value":345782500000.0},{"date":"2026-10-01","value":345792857142.86},{"date":"2026-10-06","value":345