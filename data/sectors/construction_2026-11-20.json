/2026/11/19/JTAHEO4S7BD4HJI7R3NHEXCXQ4/?utm_medium=original&utm_campaign=biz","published_at":"2026-11-19T17:21:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-11-16T15:50:28","title":"분기보고서 (2026.09)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261116001025","is_new":false},{"date":"2026-11-13T16:52:01","title":"타인에대한채무보증결정              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20261113801646","is_new":false}],"reports":[],"consensus":{"Q":{"period":"2026년 4분기","latest":200659090909.09003,"is_new":false,"series":[{"date":"2026-10-20","value":207209523809.52002},{"date":"2026-10-21","value":204400000000.0},{"date":"2026-11-02","value":202014285714.28998},{"date":"2026-11-03","value":199542105263.16},{"date":"2026-11-04","value":199405555555.56},{"date":"2026-11-05","value":199016666666.66998},{"date":"2026-11-06","value":200700000000.0},{"date":"2026-11-09","value":199065000000.0},{"date":"2026-11-11","value":199490476190.47998},{"date":"2026-11-12","value":201738095238.1},{"date":"2026-11-18","value":200659090909.09003}]},"Y":{"period":"2026년","latest":864818181818.1799,"is_new":false,"series":[{"date":"2026-10-20","value":863085714285.71},{"date":"2026-10-21","value":858942857142.8601},{"date":"2026-10-26","value":858947619047.6201},{"date":"2026-11-02","value":860033333333.3301},{"date":"2026-11-03","value":859773684210.53},{"date":"2026-11-04","value":861500000000.0},{"date":"2026-11-05","value":862833333333.3301},{"date":"2026-11-06","value":864578947368.42},{"date":"2026-11-09","value":863200000000.0},{"date":"2026-11-11","value":863619047619.05},{"date":"2026-11-12","value":865876190476.19},{"date":"2026-11-18","value":864818181818.1799}]}},"briefing":{"briefing":"주가는 큰 변동이 없었고, 협력사 차세대 경영자 육성 프로그램을 운영한다는 소식이 있었습니다. 또 현대제철과 개발한 합성보 기술의 특허와 내진 인증을 확보했지만, 주가에 직접 영향을 줬다고 보기는 어렵습니다.","content_url":"http://www.inews24.com/view/2028260","article_title":"현대건설, 협력사 차세대 경영자 육성…'HPNL 2026' 첫 도입","change_rate":1.6624},"stk_flow":[{"date":"2026-11-19","외인":3378289000,"개인":1061951000,"기관":-4435907000},{"date":"2026-11-18","외인":5153440000,"개인":-3023402000,"기관":-1874975000},{"date":"2026-11-17","외인":-2633650000,"개인":5996909000,"기관":-3526434000},{"date":"2026-11-16","외인":1083235000,"개인":-1845107000,"기관":954220000},{"date":"2026-11-13","외인":-4993465000,"개인":-2874376000,"기관":7955131000},{"date":"2026-11-12","외인":2540074000,"개인":1373082000,"기관":-3820236000},{"date":"2026-11-11","외인":-175263000,"개인":229840000,"기관":-89376000}]},{"code":"294870","name":"IPARK현대산업개발","market":"KSP","price":24950.0,"change_pct":0.6,"market_cap":1641092517000.0,"fwd_pe":3.0952234,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1774968781727207829","title":"[아파트, 생활을 분양하다] IPARK현산, AI·데이터 기반 미래형 주거 생태계 구축","summary":"주거와 헬스케어 결합한 파크로쉬 서울원 예방부터 사후관리까지 AI 기반 통합 관리 천안IPC 3,4단지 LLM 기반 AI 월패드 적용 스마트홈 IoT로 아이파크 입주민 편의 높여 인공지능(AI)과 데이터 기술이 고도화되면서 건설업계도 디지털 기술을 접목해 건강과 안전, 생활 편의까지 통합적으로 지원하는 서비스를 제공하고 있다.\n\nIPARK현대산업개발은 이러한 변화에 맞춰 AI 기반 안전관리와 디지털 헬스케어, 로봇 서비스 등을 주거 공간에 적용하며 아이파크만의 스마트 주거 경쟁력을 구축하고 있다.\n\nIPARK현대산업개발 관계자는 “디지털 기반 헬스케어를 주거 공간에 접목해 일상에서 자연스럽게 건강관리가 가능하게 한 것이 가장 큰 특징”이라며 “앞으로도 다양한 AI와 스마트 기술을 활용한 생활 밀착형 주거 서 ...","url":"https://biz.chosun.com/real_estate/real_estate_general/2026/11/19/DP2VSTJR5BHLLE6WOS5U2VCTAE/?utm_medium=original&utm_campaign=biz","published_at":"2026-11-19T17:39:00","sentiment":"positive","is_new":true},{"id":"1774904999780946091","title":"‘의정부역 센트럴 아이파크 2단지’ 연말 공급…아파트·오피스텔 457가구","summary":"의정부역 도보권에 들어서는 주거복합단지로, 중형부터 대형 펜트하우스까지 여러 주택형으로 구성된다.\n\n단지는 지하 2층~지상 최고 49층, 3개 동 규모로 아파트 334가구와 오피스텔 123실 등 총 457가구다.\n\n분양 관계자는 “의정부역 핵심 입지에 최고 49층 규모로 들어서는 데다 다양한 주택형을 갖춰 분양을 앞두고 문의가 이어지고 있다”며 “교통 여건과 기존 생활 인프라를 함께 누릴 수 있는 단지로 수요자들의 관심이 기대된다”고 말했다.","url":"https://biz.heraldcorp.com/article/10942671","published_at":"2026-11-19T13:44:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-11-17T09:22:47","title":"기업설명회(IR)개최(안내공시)              ","url":"https://dart.fss.or.