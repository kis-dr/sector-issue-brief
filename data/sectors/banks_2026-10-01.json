arket_cap":4884888835920.0,"fwd_pe":5.3499217,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1756871889566961997","title":"BNK금융, 7개 자회사 차기 CEO 선임 착수","summary":"선제적으로 은행장 등 자회사 최고경영자(CEO) 선임 절차를 손질한 BNK금융지주가 7개 자회사 대표이사에 대한 경영승계 절차에 돌입했다.\n\nBNK금융지주 자회사CEO후보추천위원회(자추위)는 30일 오후 회의를 열고 자회사 대표이사 후보 추천을 위한 절차와 향후 일정을 논의했다.\n\nBNK금융 관계자는 \"이번 경영승계 절차는 후보자의 자격과 역량을 객관적으로 검증하는 한편, 내부와 외부 후보가 공정하게 경쟁할 수 있는 환경을 마련하는 데 중점을 두고 있다\"며 \"앞으로도 경영승계 절차의 공정성과 투명성을 높여 각 자회사를 이끌 우수한 경영자를 선임할 수 있도록 최선을 다하겠다\"고 말했다.","url":"https://www.mt.co.kr/finance/2026/09/30/2026093018022288901","published_at":"2026-09-30T19:24:00","sentiment":"neutral","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":343545454545.44995,"is_new":true,"series":[{"date":"2026-08-31","value":341818181818.18005},{"date":"2026-09-30","value":343545454545.44995}]},"Y":{"period":"2026년","latest":1004585714285.71,"is_new":true,"series":[{"date":"2026-08-31","value":1003514285714.29},{"date":"2026-09-30","value":1004585714285.71}]}},"briefing":{"briefing":"최근 금융당국의 지배구조 개선 압박이 커지면서 CEO 인사 절차에 대한 우려가 증폭된 것이 주가에 부정적인 영향을 미친 것으로 보입니다. 특히, 자회사 CEO 선임 과정의 투명성을 높이려는 움직임이 불확실성을 키우고 있어요.","content_url":"https://www.segye.com/newsView/20260923510923","article_title":"거센 지배구조 압박… “계파 아닌 능력으로 뽑아야”","change_rate":-3.163},"stk_flow":[{"date":"2026-09-30","외인":-7340202000,"개인":3060935000,"기관":1106858000},{"date":"2026-09-29","외인":-2153042000,"개인":1934507000,"기관":262477000},{"date":"2026-09-28","외인":4167808000,"개인":-2693150000,"기관":-668258000},{"date":"2026-09-23","외인":14143215000,"개인":-14736392000,"기관":657217000},{"date":"2026-09-22","외인":-1197982000,"개인":2762095000,"기관":-1604884000},{"date":"2026-09-21","외인":388781000,"개인":368156000,"기관":-611060000},{"date":"2026-09-18","외인":-4983707000,"개인":3483459000,"기관":1471941000}]},{"code":"055550","name":"신한지주","market":"KSP","price":106500.0,"change_pct":-3.45,"market_cap":49808670357900.0,"fwd_pe":7.707039,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":2196615384615.38,"is_new":true,"series":[{"date":"2026-08-31","value":2225076923076.92},{"date":"2026-09-29","value":2214307692307.69},{"date":"2026-09-30","value":2196615384615.38}]},"Y":{"period":"2026년","latest":8057850000000.0,"is_new":true,"series":[{"date":"2026-08-31","value":8082975000000.0},{"date":"2026-09-29","value":8070850000000.0},{"date":"2026-09-30","value":8057850000000.0}]}},"briefing":{"briefing":"주가 하락의 주된 원인은 외국인 매도세가 지속되면서 시장 전반에 부정적인 영향을 미쳤기 때문입니다. 그러나 BNK투자증권이 신한지주의 목표가를 상향 조정한 점은 긍정적인 요소로 작용하고 있어요.","content_url":"https://www.fnnews.com/news/202609290839471575","article_title":"최대 실적에 주주환원까지…신한지주 목표가↑","change_rate":-3.9819},"stk_flow":[{"date":"2026-09-30","외인":-31876079000,"개인":20819652000,"기관":10656867000},{"date":"2026-09-29","외인":-22489345000,"개인":3708408000,"기관":18706447000},{"date":"2026-09-28","외인":-4276245000,"개인":-9911982000,"기관":14267146000},{"date":"2026-09-23","외인":-35174560000,"개인":26191391000,"기관":8804678000},{"date":"2026-09-22","외인":-3794024000,"개인":-3893628000,"기관":7682020000},{"date":"2026-09-21","외인":-4358858000,"개인":-12623615000,"기관":17438896000},{"date":"2026-09-18","외인":-17875744000,"개인":5694977000,"기관":12445935000}]},{"code":"086790","name":"하나금융지주","market":"KSP","price":130700.0,"change_pct":-2.83,"market_cap":35226088300000.0,"fwd_pe":7.2270856,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1756849072716779632","title":"하나금융, 하나은행 등 6개 관계회사 CEO 승계절차 착수","summary":"사외이사 중심 그룹임추위 운영…공정성·투명성 강화 은행 임추위 권한 확대…10월 말 최종 후보군 압축 [더팩트ㅣ이선영 기자] 하나금융그룹이 하나은행을 비롯한 주요 관계회사 최고경영자(CEO) 경영승계 절차에 들어갔다.\n\n올해부터는 은행 임추위의 역할이 최종 후보군에 대한 의견 개진까지 확대된다.\n\n압축 과정을 거쳐 선정된 최종 후보군을 은행 임추위와 공유하고, 최종 후보자 선정을 위한 평가 과정에는 은행 임추위원장이 대표로 참석해 은행 임추위 의견을 전달한다.","url":"https://news.tf.co.kr/read/economy/2371500.htm","published_at":"2026-09-30T17:48:00","sentiment":"neutral","is_new":true},{"id":"1756841970979967420","title":"[르포]하나금융 '청라시대' 열었다…\"새로운 100년 역사 향한 기회\"","summary":"30일 하나금융그룹 인청 청라 헤드쿼터 방문 비정형 곡선 이어진 건물이 그룹 비전 나타내 지역사회와 함께하는 공간으로 만들 계획 옆에 하나금융의 '심장' 통합데이터센터 있어\"하나금융그룹의 새로운 100년 역사를 그려 나갈 곳입니다.\n\n지역사회와 함께하는 공간 하나금융은 이곳을 지역사회와 함께하는 공간으로 만들 계획이다.\n\n이곳을 소개하던 하나금융 관계자는 통합데이터센터를 '하나금융그룹의 심장'이라고 표현하기도 했다.","url":"https://view.asiae.co.kr/article/2026093017341613435","published_at":"2026-09-30T17:34:00","sentiment":"positive","is_new":true},{"id":"1757012285932572856","title":"[르포]4천명 하나금융人 청라에 모인다…'연결'과 '출퇴근' 사이","summary":"청라 HQ는 지하 7층~지상 15층 규모다.\n\n노조는 성명서에서 \"허허벌판 위에 청라 HQ와 데이터센터, 연수원 등 하나금융 건물만 덩그러니 서 있을 뿐 직원들이 이용할 기반시설은 사실상 없다\"고 주장했다.\n\n건물 안에서는 직원 간 '연결'을 강조했지만, 서울과 청라를 오가는 출퇴근 문제는 이제 막 '청라시대'를 연 하나금융이 풀어야 할 과제로 남았다.","url":"https://www.nocutnews.co.kr/news/6585369?utm_medium=article&utm_campaign=20261001050110","published_at":"2026-10-01T05:02:00","sentiment":"negative","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":1649384615384.6199,"is_new":true,"series":[{"date":"2026-08-31","value":1663230769230.77},{"date":"2026-09-02","value":1666153846153.85},{"date":"2026-09-29","value":1671583333333.3298},{"date":"2026-09-30","value":1649384615384.6199}]},"Y":{"period":"2026년","latest":5960282352941.181,"is_new":true,"series":[{"date":"2026-08-31","value":5986082352941.181},{"date":"2026-09-02","value":5987047058823.53},{"date":"2026-09-29","value":5989737500000.0},{"date":"2026-09-30","value":5960282352941.181}]}},"briefing":{"briefing":"주가 하락의 직접적인 이유는 확인되지 않았지만, 최근 청년 소상공인 상권 활성화 프로젝트와 관련된 뉴스가 있었어요. 이러한 프로젝트는 긍정적인 사회적 영향이 있을 수 있지만, 주가에는 즉각적인 반영이 없었던 것으로 보입니다.","content_url":"https://www.mt.co.kr/economy/2026/09/30/2026093009540919678","article_title":"소진공,'하나 ON, 청년 ON'  청년 소상공인 상권 활성화 프로젝트 '시동'","change_rate":-3.9172},"stk_flow":[{"date":"2026-09-30","외인":-3482623000,"개인":27311653000,"기관":-24260470000},{"date":"2026-09-29","외인":2587284000,"개인":478024000,"기관":-3090467000},{"date":"2026-09-28","외인":11004187000,"개인":-6574106000,"기관":-4426713