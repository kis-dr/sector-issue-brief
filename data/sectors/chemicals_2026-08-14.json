506139000,"기관":267074000},{"date":"2026-08-06","외인":165990000,"개인":-681921000,"기관":531722000},{"date":"2026-08-05","외인":-211716000,"개인":59492000,"기관":150706000}]},{"code":"051910","name":"LG화학","market":"KSP","price":275500.0,"change_pct":0.0,"market_cap":19448190496500.0,"fwd_pe":12.647936,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1739447466941616167","title":"LG화학, 독립이사 참가 해외 거버넌스 설명회 첫 개최","summary":"이영한 서울시립대 교수 동행 회계·세무·재무 분야의 전문가 LG화학의 첫 해외 거버넌스 기업설명회(NDR)에 독립이사가 나선다.\n\nLG화학(051910)은 13일 홍콩 및 싱가폴에서 글로벌 투자기관을 대상으로 개최하는 해외 거버넌스 NDR에 이영한(사진) 독립이사가 참가한다고 밝혔다.\n\nLG화학 독립이사가 NDR에 직접 참가하는 것은 이번이 처음이다.","url":"https://www.sedaily.com/article/20079162","published_at":"2026-08-13T17:44:00","sentiment":"positive","is_new":true},{"id":"1739407505353740677","title":"LG화학 이영한 독립이사, 해외 투자자와 첫 직접 소통","summary":"LG화학이 처음으로 독립이사가 직접 참여하는 해외 거버넌스 기업설명회를 개최합니다.\n\n이 독립이사는 LG화학에서 지난 2024년 3월 분리 선출된 감사위원으로 선임돼, 현재 감사위원장을 맡고 있습니다.\n\n한편, LG화학은 지난 2월 조화순 독립이사를 이사회 의장으로 선임해 대표이사와 이사회 의장을 분리하는 등 독립성과 경영 투명성을 강화하고 있다고 밝혔습니다.","url":"http://www.yonhapnewstv.co.kr/news/AKR20260813150503fVT","published_at":"2026-08-13T15:05:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-08-13T13:35:50","title":"기업설명회(IR)개최(안내공시)              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260813800423","is_new":true},{"date":"2026-08-07T15:29:40","title":"주식등의대량보유상황보고서(일반)","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260807000440","is_new":false}],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":223283333333.33002,"is_new":false,"series":[{"date":"2026-07-14","value":532414285714.29004},{"date":"2026-07-20","value":520660000000.0},{"date":"2026-07-23","value":510868750000.0},{"date":"2026-07-24","value":537060000000.0},{"date":"2026-07-31","value":516450000000.0},{"date":"2026-08-03","value":318562500000.0},{"date":"2026-08-04","value":223283333333.33002}]},"Y":{"period":"2026년","latest":1302146153846.15,"is_new":false,"series":[{"d