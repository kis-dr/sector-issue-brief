nge_pct":-0.6,"market_cap":1338615220000.0,"fwd_pe":9.385449,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1747612196399091862","title":"“케첩 하나로 55년 버텼는데”…하인즈·오뚜기, ‘소스 전쟁’ 판 커졌다","summary":"하인즈 제공 오뚜기와 하인즈가 장기간 쌓아온 케첩 브랜드 경쟁력에 대상 청정원과 동원홈푸드 비비드키친 등이 ‘저당·저칼로리’를 앞세워 가세하면서다.\n\n하인즈는 국내에서 대표 제품인 토마토케첩을 중심으로 제품군을 확대하는 동시에 최근에는 소비자가 직접 브랜드를 경험하는 마케팅에 공을 들이고 있다.\n\n업계에서는 앞으로 소스 시장에서 기존 브랜드 인지도만큼이나 ‘저당·저칼로리’, 특정 음식에 맞춘 용도형 제품, 소비자 체험과 SNS 확산력이 중요해질 것으로 보고 있다.","url":"https://www.segye.com/newsView/20260905501338","published_at":"2026-09-05T06:22:00","sentiment":"neutral","is_new":true},{"id":"1747317800302678609","title":"오뚜기, 타바스코·타코부스 협업…'치폴레 싸이 타코' 선봬","summary":"오뚜기는 글로벌 핫소스 브랜드 타바스코®와 멕시칸 푸드 브랜드 타코부스가 협업해 기간 한정 메뉴 '치폴레 싸이 타코 with 타바스코® 살사 피칸테'를 선보인다고 4일 밝혔다.\n\n협업 기간 타코부스 매장에는 타바스코® 오리지널 핫소스와 살사 피칸테를 함께 비치한 소스존도 운영한다.\n\n오뚜기 관계자는 “타바스코® 살사 피칸테를 멕시칸 푸드와 함께 보다 맛있고 친숙하게 경험할 수 있도록 이번 협업을 마련했다”며 “앞으로도 다양한 외식 브랜드와 협업해 타바스코® 소스만의 다채로운 맛과 활용법을 소비자에게 소개해 나가겠다”고 말했다.","url":"https://www.etnews.com/20260904000108","published_at":"2026-09-04T10:48:00","sentiment":"positive","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{},"Y":{}},"briefing":{"briefing":"주가는 크게 변동하지 않았지만, 최근 가격 인상 소식이 주목받고 있습니다. 특히 오뚜기밥의 가격이 최대 29.4% 인상된 점이 소비자들에게 영향을 미칠 것으로 보입니다.","content_url":"https://www.edaily.co.kr/News/Read?newsId=05343126645575856&mediaCodeNo=257&utm_medium=referral&utm_campaign=news_syndication&utm_content=original_article","article_title":"오뚜기밥 편의점 판매가 최대 29.4% 인상…4년 5개월 만","change_rate":-0.5952},"stk_flow":[{"date":"2026-09-04","외인":-587323000,"개인":370412000,"기관":215257000},{"date":"2026-09-03","외인":654750000,"개인":-708548000,"기관":57500000},{"date":"2026-09-02","외인":600705000,"개인":-548653000,"기관":144808000},{"date":"2026-09-01","외인":-3592000,"개인":120050000,"기관":-47827000},{"date":"2026-08-31","외인":-203320000,"개인":64527000,"기관":149705000},{"date":"2026-08-28","외인":602073000,"개인":-1045488000,"기관":477630000},{"date":"2026-08-27","외인":-509917000,"개인":404539000,