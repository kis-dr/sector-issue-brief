hange_pct":0.24,"market_cap":3692645370800.0,"fwd_pe":7.826578,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1776958988206870869","title":"‘리니지’ IP 강화하는 엔씨… 실적 반등 드라이브","summary":"리니지 클래식의 흥행 성과도 기대를 웃돌고 있다.\n\n엔씨는 다음 달 2일 일본에서도 리니지 클래식 서비스를 시작한다.\n\n엔씨는 리니지 클래식과 ‘아이온2’ 흥행을 바탕으로 올해 매출 목표를 2조8000억원으로 상향했다.","url":"https://www.segye.com/newsView/20261124516221","published_at":"2026-11-25T06:03:00","sentiment":"positive","is_new":true},{"id":"1776679739822576256","title":"리니지 클래식 시즌2, 독자 노선간다…엔씨 \"원작 만화 설정대로\" [현장]","summary":"12월 2일 시즌2 '트리아' 업데이트…신규 클래스 '도적' 등장·내년 한·대만·일 국가대항전 추진 \"과거 리니지 오리지널이 가려고 했던 길과 전혀 다른 형태의 업데이트를 준비하고 있습니다.\n\n엔씨는 오는 12월2일 시즌2 첫 번째 에피소드인 '트리아'를 시작으로 23년 전 폐기했던 개발 기획을 되살려 리니지 클래식만의 독자적인 세계관을 구축한다는 전략이다.\n\n엔씨는 내년까지 순차적으로 원작 만화의 설정을 반영한 시즌2 에피소드 6개를 선보일 계획이다.","url":"https://www.ddaily.co.kr/page/view/2026112411154148864","published_at":"2026-11-24T11:29:00","sentiment":"positive","is_new":true},{"id":"1776596034278002754","title":"NC AI, ‘VARCO 알럼나이 데이’ 개최…일주일 만에 100명 돌파","summary":"행사에서는 게임 출시와 마케팅, AI 활용 개발 전략 등 실무 경험을 공유하는 강연이 진행된다.\n\n생성형 AI를 실제 게임 제작에 활용한 개발자의 경험도 공유된다.\n\nNC AI는 K-뉴딜 아카데미를 통해 생성형 AI 기반 게임 개발 교육을 운영해 왔다.","url":"https://www.sedaily.com/article/20117971","published_at":"2026-11-24T06:01:00","sentiment":"neutral","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 4분기","latest":159525000000.0,"is_new":true,"series":[{"date":"2026-10-26","value":163723529411.76},{"date":"2026-11-02","value":165400000000.0},{"date":"2026-11-03","value":167258823529.41},{"date":"2026-11-05","value":165882352941.18},{"date":"2026-11-10","value":165055555555.56},{"date":"2026-11-12","value":158915000000.0},{"date":"2026-11-16","value":158880000000.0},{"date":"2026-11-24","value":159525000000.0}]},"Y":{"period":"2026년","latest":562645000000.0,"is_new":true,"series":[{"date":"2026-10-26","value":550644444444.4401},{"date":"2026-11-02","value":553566666666.6699},{"date":"2026-11-03","value":557216666666.669