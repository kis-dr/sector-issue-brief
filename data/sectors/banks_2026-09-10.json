0555000,"기관":2921585000},{"date":"2026-09-08","외인":-1039560000,"개인":56193000,"기관":1023420000},{"date":"2026-09-07","외인":-534498000,"개인":-789992000,"기관":1316635000},{"date":"2026-09-04","외인":-1978676000,"개인":1939302000,"기관":-36399000},{"date":"2026-09-03","외인":-580829000,"개인":-697550000,"기관":1337414000},{"date":"2026-09-02","외인":560923000,"개인":-2305670000,"기관":1758588000},{"date":"2026-09-01","외인":3043416000,"개인":-4628167000,"기관":1804877000}]},{"code":"105560","name":"KB금융","market":"KSP","price":172000.0,"change_pct":-0.98,"market_cap":61006290248000.0,"fwd_pe":8.629966,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1749095231841767847","title":"KB금융, 11일 차기 회장 최종 후보 결정...양종희 연임 여부 주목","summary":"KB금융그룹의 차기 회장 후보가 오는 11일 결정되는 가운데 현직인 양종희 KB금융 회장이 연임에 성공할지에 관심이 모인다.\n\n9일 금융권에 따르면 KB금융 회장후보추천위원회(회추위)는 오는 11일 회장 후보군 양 회장과 함께 이재근 KB금융 부문장, 외부 후보인 권광석 전 우리은행장 3명을 대상으로 심층 인터뷰를 진행한 뒤 최종 후보 1명을 확정할 예정이다.\n\n지난달 27일 차기 회장 후보 6명을 대상으로 심층 인터뷰를 거쳐 최종 후보 3명을 압축한 바 있다.","url":"https://biz.chosun.com/stock/finance/2026/09/09/RXPD7RMKYBEJ7MYJIF7QPGWRQI/?utm_medium=original&utm_campaign=biz","published_at":"2026-09-09T08:43:00","sentiment":"neutral","is_new":true},{"id":"1749417080668688481","title":"나신평 \"주주환원에 생산적금융까지…은행 자본관리 부담 가중\"","summary":"금융지주들의 주주환원 확대와 정부의 생산적금융 기조가 맞물리면서 은행권의 자본관리 부담이 커질 것이란 전망이 나왔다.\n\n우선 금융지주의 주주환원 확대가 은행의 자본 축적에 부담으로 작용하고 있다.\n\n여기에 생산적금융 확대도 은행의 자본관리 부담을 높일 것으로 전망된다.","url":"https://www.newsis.com/view/NISX20260909_0003783271","published_at":"2026-09-10T06:00:00","sentiment":"negative","is_new":true},{"id":"1749197672247595210","title":"BS그룹-KB금융 ‘맞손’…에너지·AI 신사업 협력 확대","summary":"솔라시도 등 대규모 개발사업서 협업 M&A·IPO·ESG까지 협력 범위 확대 BS그룹이 KB금융그룹과 손잡고 신재생에너지와 인공지능(AI) 데이터센터와 도시개발 등 미래 성장사업 확대를 위해 협력한다.\n\n양측은 산업과 금융 분야에서 각각 쌓아온 역량을 결합해 대규모 개발사업과 신성장 분야에서 협력을 강화할 계획이다.\n\nBS그룹 관계자는 “주택과 도시개발, 에너지 인프라, AI 데이터센터 등 대규모 사업을 안정적으로 추진하려면 금융 파트너와의 협력이 중요하다”며 “KB금융그룹과의 협업을 통해 기존 사업의 추진력을 높이고 새로운 성장사업을 발굴하는 과정에서도 시너지를 낼 것으로 기대한다”고 말했다.","url":"https://www.sedaily.com/article/20088956","published_at":"2026-09-09T15:29:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-09-04T13:31:54","title":"기업설명회(IR)개최(안내공시)              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260904800176","is_new":false}],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":2540058333333.33,"is_new":false,"series":[{"date":"2026-08-10","value":2540058333333.33}]},"Y":{"period":"2026년","latest":9421417647058.82,"is_new":false,"series":[{"date":"2026-08-10","value":9421417647058.82}]}},"briefing":{"briefing":"주가가 크게 변동하지 않았지만, 금융감독원의 정기검사 착수 소식이 부정적인 영향을 미쳤던 것으로 보입니다. 검사 내용이 지배구조와 내부통제 등 경영 전반에 걸쳐 있어 시장의 우려를 자아낸 것 같습니다.","content_url":"https://www.sedaily.com/article/20088157","article_title":"금감원, KB금융 정기검사 착수","change_rate":-0.9787},"stk_flow":[{"date":"2026-09-09","외인":3297495000,"개인":2007710000,"기관":-4735961000},{"date":"2026-09-08","외인":1787112000,"개인":3648276000,"기관":-4058725000},{"date":"2026-09-07","외인":-1983726000,"개인":-24673802000,"기관":28227858000},{"date":"2026-09-04","외인":-55976058000,"개인":30018343000,"기관":27503367000},{"date":"2026-09-03","외인":-10653692000,"개인":-56287180000,"기관":66535690000},{"date":"2026-09-02","외인":-6720313000,"개인":-3805674000,"기관":8483569000},{"date":"2026-09-01","외인":-7851859000,"개인":10975156000,"기관":-2004027000}]},{"code":"024110","name":"기업은행","market":"KSP","price":20600.0,"change_pct":-0.96,"market_cap":16426972901400.0,"fwd_pe":5.604145,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1749358427269894270","title":"[금융뒷담] IBK기업은행, “830억 털리고도 몰랐다” 왜?","summary":"책무구조도 도입 후 임원 제재 ‘0건’ 사고 늑장 인지에 ‘셀프 점검’ 논란 올해 IBK기업은행의 금융사고 금액이 1100억원을 넘어서면서 내부통제 실효성 논란이 커지고 있다.\n\n금융사 임원의 책임을 사전에 명확히 하겠다며 도입한 ‘책무구조도’가 대형 사고 앞에서 유명무실한 것 아니냐는 지적이 나온다.\n\n업무별로 내부통제 책임을 맡을 임원을 미리 지정해 사고 발생 이후 책임 공방을 줄이자는 취지로 도입된 제도다.","url":"https://www.kmib.co.kr/article/view.asp?arcid=9000010706","published_at":"2026-09-10T02:08:00","sentiment":"negative","is_new":true},{"id":"1749224442384486472","title":"기업은행, 대출사기 보고후 2주 만에 또 당해…자체점검선 \"문제 없어\"","summary":"기업은행이 이 사기 조직에 내준 대출은 12개 차주 14건, 244억6000만원에 달하는데 이 같은 규모가 드러난 것은 은행의 자체 점검이 아니라 경찰 수사를 통해서였다.\n\n기업은행이 지난해 10월 처음 금감원에 보고한 금액은 9억6500만원 1건이었다.\n\n당시 기업은행이 파악한 건은 인천 연수구 송도동 상가에 나간 1건뿐이었고, 2주 뒤 대출은 취급 지점과 차주, 시행사, 담보 물건이 모두 달랐다.","url":"https://news.bizwatch.co.kr/article/finance/2026/09/09/0027","published_at":"2026-09-09T17:14:00","sentiment":"negative","is_new":true},{"id":"1749187131911311907","title":"IBK기업은행, 유로머니 어워즈서 '3관왕' 석권","summary":"기업은행은 '유로머니 어워즈 포 엑설런스'에서 대한민국 최우수 중기금융, 중소기업 디지털, 환경·사회·지배구조(ESG) 등 3개 부문을 동시 수상했다.\n\n중소기업 대상 ESG 컨설팅 및 관련 금융상품 공급도 주요 수상 요인으로 꼽힌다.\n\n장민영 IBK기업은행장 은행장은 “독보적인 중기금융 역량에 인공지능(AI) 등 디지털 혁신과 ESG 경영 가치를 접목한 노력이 결실을 맺었다”며 “앞으로도 중소기업의 도약과 성장을 뒷받침하겠다”고 말했다.","url":"https://www.etnews.com/20260909000301","published_at":"2026-09-09T14:47:00","sentiment":"positive","is_new":true}],"disclosures":[],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":1023200000000.0,"is_new":false,"series":[{"date":"2026-08-10","value":1023200000000.0}]},"Y":{"period":"2026년","latest":3715123076923.08,"is_new":false,"series":[{"date":"2026-08-10","value":3702257142857.14},{"date":"2026-08-20","value":3715123076923.08}]}},"briefing":{"briefing":"최근 대출사기 사건과 관련된 부정적인 뉴스가 주가에 영향을 미친 것으로 보입니다. 특히, 금융사고를 인지하지 못한 점이 부각되면서 신뢰도에 타격을 입은 상황입니다.","content_url":"https://www.khan.co.kr/article/202609091557001","article_title":"영장 받고도 대출사기 인지 못한 기업은행…사고 확인 후에도 추가 대출","change_rate":-0.9615},"stk_flow":[{"date":"2026-09-09","외인":-3236772000,"개인":2437625000,"기관":980134000},{"date":"2026-09-08","외인":-888004000,"개인":309062000,"기관":629023000},{"date":"2026-09-07","외인":17047000,"개인":-4084730000,"기관":4051197000},{"date":"2026-09-04","외인":-13010484000,"개인":6235947000,"기관":6457070000},{"date":"2026-09-03","외인":6701075000,"개인":-8310591000,"기관":1754538000},{"date":"2026-09-02","외인":5664608000,"개인":-4801581000,"기관":-568835000},{"date":"2026-09-01","외인":634303000,"개인":-3055003000,"기관":2513726000}]},{"code