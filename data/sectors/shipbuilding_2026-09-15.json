_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1750932289401000452","title":"차세대 쇄빙연구선…경남에서 만든다","summary":"우리나라 첫 쇄빙연구선 아라온호에 이어, 더 크고 강력한 차세대 쇄빙연구선이 거제에서 건조됩니다.\n\n조선업계는 새 연구선 건조를 통해 극지 특수선 분야 기술 경쟁력을 높일 수 있을 것으로 기대하고 있습니다.\n\n새 연구선은 올해 건조를 시작해 2029년 시운전을 거쳐, 2030년부터 북극 연구에 투입됩니다.","url":"https://news.kbs.co.kr/news/pc/view/view.do?ncd=8662439&ref=A","published_at":"2026-09-14T09:40:00","sentiment":"positive","is_new":true},{"id":"1750998248585302033","title":"한화오션, 미래 조선해양 이끌 부산 경남 동남권 인재 육성에 총력","summary":"부산대에 한화 채용조건형 '첨단기계시스템공학과' 신설 경상국립대 국립창원대는 석사과정 AI 인재 집중 육성 하반기 신입사원 채용 들어가, 지역 인재 채용 확대 경남 거제에 사업장을 둔 한화오션이 미래 조선·해양산업을 이끌 우수인재 확보를 위해 부산·경남 등 동남권 인재 육성에 총력을 기울이고 있다.\n\n한화오션은 2023년 5월 출범 이후 미래 조선·해양산업을 이끌 우수 인재를 확보하기 위해 채용을 확대해 왔다.\n\n한화오션은 올 하반기 신입사원 채용에 들어갔다.","url":"http://www.kookje.co.kr/news2011/asp/newsbody.asp?code=0300&key=20260914.99099004332","published_at":"2026-09-14T14:42:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-09-10T16:52:53","title":"기업설명회(IR)개최(안내공시)              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260910800549","is_new":false},{"date":"2026-09-09T07:39:04","title":"투자판단관련주요경영사항              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260909800003","is_new":false}],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":570127777777.78,"is_new":false,"series":[{"date":"2026-08-18","value":570627777777.78},{"date":"2026-09-08","value":570127777777.78}]},"Y":{"period":"2026년","latest":2252145000000.0,"is_new":false,"series":[{"date":"2026-08-18","value":2252995000000.0},{"date":"2026-09-08","value":2252145000000.0}]}},"briefing":{"briefing":"이번 상승은 세계 최대 가스 전시회인 가스텍 2026에서 자체 개발한 60MW급 부유식 데이터센터를 처음 공개한 것이 큰 영향을 미친 것으로 보입니다. 새로운 기술이 주목받으면서 향후 시장에서의 경쟁력 강화 기대감이 커지고 있어요.","content_url":"https://www.mk.co.kr/article/12151439","article_title":"한화오션 '바다 위 데이터센터' 첫 공개","change_rate":0.3505},"stk_flow":[{"date":"2026-09-14","외인":10429956000,"개인":-10307063000,"기관":-25166900