_cap":950832494200.0,"fwd_pe":6.6553082,"fwd_pb":null,"has_chart":true,"has_new":true,"news":[{"id":"1736135979531637151","title":"롯데웰푸드 설레임, 기안84와 달린다","summary":"9월 5일 하남 설레임런...소비자 참여형 캠페인 강화 신규 패키지 및 신제품 출시로 제품 경쟁력 끌어올려 [이코노미스트 이지완 기자] 롯데웰푸드가 대표 아이스크림 브랜드 설레임을 앞세워 여름 성수기 공략에 박차를 가한다.\n\n롯데웰푸드 설레임 경쟁력 강화를 위해 손시림 현상 개선을 위한 신규 패키지도 도입했다.\n\n롯데웰푸드 관계자는 \"설레임은 시원함이 필요한 순간 가장 먼저 생각나는 아이스크림 브랜드가 되고자 다양한 소비자 경험을 확대하고 있다\"며 \"설레임런과 신제품, 패키지 리뉴얼 등을 통해 설레임만의 차별화된 쿨링 경험과 즐거움을 더욱 많은 소비자들에게 전달할 계획\"이라고 말했다.","url":"https://economist.co.kr/article/view/ecn202608040025","published_at":"2026-08-04T14:27:00","sentiment":"positive","is_new":true},{"id":"1736081822951019131","title":"롯데웰푸드, 1형당뇨 환자 지원…“캠프·희망가방 후원”","summary":"40가정 가족캠프에 간식 제공…진단 초기 적응도 도와 롯데웰푸드가 무설탕·무당류 디저트 브랜드 ‘제로’를 통해 1형당뇨병 환자와 가족을 후원하는 사업을 전개한다고 4일 밝혔다.\n\n롯데웰푸드는 1형당뇨병을 처음 진단받은 환자와 가족에게 혈당관리 의료기기·교육 자료·생활용품 등을 제공하는 ‘희망가방 프로젝트’ 사업에도 참여한다.\n\n제로 레몬민트캔디·피치민트캔디·후르츠젤리 등 진단 초기 환자들이 일상에서 즐길 수 있는 간식을 제공할 계획이다.","url":"https://biz.heraldcorp.com/article/10830134","published_at":"2026-08-04T10:52:00","sentiment":"positive","is_new":true}],"disclosures":[{"date":"2026-07-31T10:41:07","title":"기업설명회(IR)개최(안내공시)              ","url":"https://dart.fss.or.kr/dsaf001/main.do?rcpNo=20260731800336","is_new":false}],"reports":[],"consensus":{"Q":{"period":"2026년 3분기","latest":83318181818.18,"is_new":false,"series":[{"date":"2026-07-06","value":83700000000.0},{"date":"2026-07-07","value":83690000000.0},{"date":"2026-07-09","value":83840000000.0},{"date":"2026-07-13","value":83260000000.0},{"date":"2026-07-16","value":83360000000.0},{"date":"2026-07-21","value":83227272727.27},{"date":"2026-07-27","value":83318181818.18}]},"Y":{"period":"2026년","latest":191609090909.09003,"is_new":false,"series":[{"date":"2026-07-06","value":187820000000.0},{"date":"2026-07-07","value":188040000000.0},{"date":"2026-07-09","value":188880000000.0},{"date":"2026-07-13","value":189230000000.0},{"date":"2026-07-16","value":190230000000.0},{"date":"2026-0